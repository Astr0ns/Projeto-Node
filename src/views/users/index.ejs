<%- include('../partials/header') %>

<div class="page-header">
  <h1>Usuários</h1>
</div>

<% if (users.length === 0) { %>
  <p class="empty">Nenhum usuário cadastrado.</p>
<% } else { %>
  <table class="table">
    <thead>
      <tr>
        <th>#</th>
        <th>Nome</th>
        <th>E-mail</th>
        <th>Cadastrado em</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr>
          <td><%= u.id %></td>
          <td><%= u.name %></td>
          <td><%= u.email %></td>
          <td><%= new Date(u.created_at).toLocaleDateString('pt-BR') %></td>
          <td class="actions">
            <a href="/users/<%= u.id %>" class="btn btn-sm">Ver</a>
            <a href="/users/<%= u.id %>/edit" class="btn btn-sm btn-outline">Editar</a>
            <form action="/users/<%= u.id %>?_method=DELETE" method="POST" style="display:inline"
                  onsubmit="return confirm('Excluir este usuário?')">
              <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
