<%- include('../partials/header') %>

<div class="form-container">
  <h1>Cadastrar</h1>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <form action="/register" method="POST">
    <div class="form-group">
      <label for="name">Nome</label>
      <input type="text" id="name" name="name" required placeholder="Seu nome" />
    </div>
    <div class="form-group">
      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" required placeholder="seu@email.com" />
    </div>
    <div class="form-group">
      <label for="password">Senha</label>
      <input type="password" id="password" name="password" required placeholder="Mínimo 6 caracteres" minlength="6" />
    </div>
    <button type="submit" class="btn btn-full">Criar conta</button>
  </form>
  <p class="form-footer">Já tem conta? <a href="/login">Entrar</a></p>
</div>

<%- include('../partials/footer') %>
